# --- required -------------------------------------------------------------
# Claude API key. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# GitHub token with read access to pull requests. Needs write access only if
# you use --reply or --resolve.
GITHUB_TOKEN=ghp_...

# --- model ----------------------------------------------------------------
PR_AGENT_MODEL=claude-opus-5
PR_AGENT_MAX_TOKENS=16000
# Adaptive thinking: Claude decides how much to think per request.
PR_AGENT_THINKING=true

# --- retrieval ------------------------------------------------------------
# local  : sentence-transformers on your machine, no extra API key
# voyage : Voyage AI embeddings (best for code), needs VOYAGE_API_KEY
# none   : skip embeddings entirely and use BM25 keyword retrieval only
PR_AGENT_EMBEDDINGS=local
PR_AGENT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# VOYAGE_API_KEY=pa-...
# PR_AGENT_VOYAGE_MODEL=voyage-code-3

PR_AGENT_INDEX_DIR=.pr_agent/index
PR_AGENT_CHUNK_SIZE=1200
PR_AGENT_CHUNK_OVERLAP=150
PR_AGENT_RETRIEVAL_K=8

# --- behaviour ------------------------------------------------------------
# Commands run after each implemented comment; ';;' separates them.
PR_AGENT_VALIDATE=ruff check .;;python -m pytest -q
PR_AGENT_VALIDATE_TIMEOUT=900
PR_AGENT_MAX_FIX_ATTEMPTS=3
PR_AGENT_MAX_TOOL_ITERATIONS=25

# --- web UI ---------------------------------------------------------------
# Repository the UI opens on by default; `pr-agent serve --repo` overrides it.
# PR_AGENT_REPO_PATH=.

# For a self-hosted GitHub Enterprise instance:
# GITHUB_API_URL=https://github.example.com/api/v3
