# --- required -------------------------------------------------------------
# Gemini API key. https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# GitHub token with read access to pull requests. Needs write access only if
# you use --reply or --resolve.
GITHUB_TOKEN=ghp_...

# --- model ----------------------------------------------------------------
# google (Gemini, the default) or anthropic (Claude, needs the [anthropic]
# extra installed and ANTHROPIC_API_KEY set).
PR_AGENT_PROVIDER=google
# Defaults per provider: gemini-3.8-flash / claude-opus-5. Pro-tier Gemini
# models (gemini-3.1-pro-preview) need a paid API plan.
PR_AGENT_MODEL=gemini-3.8-flash
PR_AGENT_MAX_TOKENS=16000
# Let the model decide how much to think per request. Gemini 3 models always
# think, so turning this off only takes effect on Gemini 2.x and Claude.
PR_AGENT_THINKING=true

# ANTHROPIC_API_KEY=sk-ant-...

# --- tracing --------------------------------------------------------------
# LangSmith. With a key set, every run, node and model call is traced.
# https://smith.langchain.com/settings
# LANGSMITH_API_KEY=lsv2_pt_...
# Set to false to keep the key but stop sending traces (or pass --no-trace).
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=pr-review-implementor
# The region the key was issued in. US is the default; a key from another
# region is rejected with a 403 against the wrong one.
#   EU   : https://eu.api.smith.langchain.com
#   APAC : https://apac.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- retrieval ------------------------------------------------------------
# BM25 keyword retrieval over code-aware tokens, rebuilt in memory on each
# run. No model download, no extra API key, and nothing to keep in sync.
PR_AGENT_CHUNK_SIZE=1200
PR_AGENT_CHUNK_OVERLAP=150
PR_AGENT_RETRIEVAL_K=8

# --- behaviour ------------------------------------------------------------
# Commands run after each implemented comment; ';;' separates them.
PR_AGENT_VALIDATE=ruff check .;;python -m pytest -q
PR_AGENT_VALIDATE_TIMEOUT=900
PR_AGENT_MAX_FIX_ATTEMPTS=3
PR_AGENT_MAX_TOOL_ITERATIONS=25

# --- web UI ---------------------------------------------------------------
# Repository the UI opens on by default; `pr-agent serve --repo` overrides it.
# PR_AGENT_REPO_PATH=.

# For a self-hosted GitHub Enterprise instance:
# GITHUB_API_URL=https://github.example.com/api/v3
